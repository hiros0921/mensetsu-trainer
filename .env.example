# これをコピーして .env を作り、値を入れる。
#
#   cp .env.example .env
#   chmod 600 .env
#
# .env は .gitignore 済み。リポジトリに入らない（仕様書10章）。

# ── Claude API ──
# 第4段階から必要。第3段階まではスタブで動くので空でよい。
# キーはここに直接貼る。チャットに貼らないこと。
ANTHROPIC_API_KEY=

# 面接官の発話を生成するモデル。
# 深掘りの質問は質が要るので、ここは落とさない方針。
MENSETSU_LLM_MODEL=claude-opus-5

# ── PostgreSQL ──
# docker compose と Spring の両方がこれを読む。
POSTGRES_USER=mendan
POSTGRES_PASSWORD=mendan_dev_only
POSTGRES_PORT=55433
